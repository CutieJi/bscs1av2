# Copy this file to .env and fill in values for your environment.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Generate a random secret with at least 64 characters.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
PORT=3000
APP_BASE_URL=https://uccmis.vercel.app/

# Cloudflare Turnstile (required for public registration).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and add the site key and secret key for your deployment's hostnames.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# SMTP email delivery (Gmail users need an App Password, not their account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="MISLend Security <your-email@gmail.com>"

# TextBee SMS (required for automatic and manual SMS reminders).
# Keep the API key server-side; configure it in the server/Vercel environment.
TEXTBEE_API_KEY=your-textbee-api-key
# Optional: omit to use TextBee's default enabled device.
TEXTBEE_DEVICE_ID=
# TextBee's free plan has service limits; your Android SIM/carrier plan may
# still charge for SMS. Keep the phone powered on and connected to the internet.

# Protects the scheduled overdue scan endpoint. Use a long random value.
CRON_SECRET=replace-with-a-long-random-secret
